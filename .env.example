NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lander_creators
AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-characters
AUTH_BASE_URL=http://localhost:3000
EMAIL_DELIVERY_MODE=disabled
LOG_LEVEL=info
# Dev-only authentication bypass. Honoured ONLY when NODE_ENV=development AND this is exactly "true".
# Authentication is intentionally disabled in local/development by product-owner decision. Never set in CI/production.
LANDER_DEV_AUTH_BYPASS=false
